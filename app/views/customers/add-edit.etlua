<h1 class="h4 mb-3"><%= customer and "Edit Customer" or "Add Customer" %></h1>
<form method="POST" action="<%= customer and ("/customers/" .. customer.id .. "/edit") or "/customers/create" %>">
  <input type="hidden" name="csrf_token" value="<%= csrf_token %>" />

  <div class="mb-3">
    <label for="first_name" class="form-label">First Name</label>
    <input
      type="text"
      class="form-control"
      id="first_name"
      name="first_name"
      value="<%= customer and customer.first_name or "" %>"
      required
    />
  </div>
  <div class="mb-3">
    <label for="middle_name" class="form-label">Middle Name</label>
    <input
      type="text"
      class="form-control"
      id="middle_name"
      name="middle_name"
      value="<%= customer and customer.middle_name or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="last_name" class="form-label">Last Name</label>
    <input
      type="text"
      class="form-control"
      id="last_name"
      name="last_name"
      value="<%= customer and customer.last_name or "" %>"
      required
    />
  </div>
  <div class="mb-3">
    <label for="suffix_name" class="form-label">Suffix</label>
    <input
      type="text"
      class="form-control"
      id="suffix_name"
      name="suffix_name"
      value="<%= customer and customer.suffix_name or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="phone_number" class="form-label">Phone Number</label>
    <input
      type="text"
      class="form-control"
      id="phone_number"
      name="phone_number"
      value="<%= customer and customer.phone_number or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="email" class="form-label">Email</label>
    <input
      type="email"
      class="form-control"
      id="email"
      name="email"
      value="<%= customer and customer.email or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="address1" class="form-label">Address</label>
    <input
      type="text"
      class="form-control"
      id="address1"
      name="address1"
      value="<%= customer and customer.address1 or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="address2" class="form-label">Address 2</label>
    <input
      type="text"
      class="form-control"
      id="address2"
      name="address2"
      value="<%= customer and customer.address2 or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="city" class="form-label">City</label>
    <input
      type="text"
      class="form-control"
      id="city"
      name="city"
      value="<%= customer and customer.city or "" %>"
    />
  </div>
  <div class="mb-3">
    <label for="state" class="form-label">State</label>
    <select
      class="form-select"
      id="state"
      name="state"
    >
      <option value="">Select a state...</option>
      <% for _, state in ipairs(data.states) do %>
        <option value="<%= state.code %>" <%= (customer and customer.state == state.code) and "selected" or "" %>>
          <%= state.name %>
        </option>
      <% end %>
    </select>
  </div>
  <div class="mb-3">
    <label for="zip_code" class="form-label">Zip Code</label>
    <input
      type="text"
      class="form-control"
      id="zip_code"
      name="zip_code"
      value="<%= customer and customer.zip_code or "" %>"
    />
  </div>
  <button type="submit" class="btn btn-primary"><%= customer and "Update Customer" or "Add Customer" %></button>
</form>