<h1 class="h4 mb-3">Customers</h1>

<!-- Add New Customer Button -->
<a href="/customers/create" class="btn btn-primary mb-3">Add New Customer</a>

<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Name</th>
      <th scope="col">Email</th>
      <th scope="col">Phone</th>
      <th scope="col">Vehicles</th>
      <th scope="col">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if #customers == 0 then %>
      <tr>
        <td colspan="6" class="text-center">No customers found.</td>
      </tr>
    <% end %>
    <% for _, customer in ipairs(customers) do %>
      <tr>
        <th scope="row"><%= customer.id %></th>
        <td><%= customer.first_name %> <%= customer.last_name %></td>
        <td><%= customer.email %></td>
        <td><%= helpers.format_phone(customer.phone_number) %></td>
        <td><%= customer.vehicle_count or 0 %></td>
        <td>
          <div class="btn-group" role="group" aria-label="Actions">
            <a href="/customers/<%= customer.id %>" class="btn btn-sm btn-primary text-white">View</a>
            <a href="/customers/<%= customer.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>