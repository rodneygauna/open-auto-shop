<h1 class="h4 mb-3"><%= vehicle and "Edit Vehicle" or "Add Vehicle" %></h1>
<form method="POST" action="<%= vehicle and ("/vehicles/" .. vehicle.id .. "/edit") or "/vehicles/create" %>">
  <input type="hidden" name="csrf_token" value="<%= csrf_token %>" />

  <!-- Select Customer -->
  <div class="mb-4">
    <label for="customer_id" class="block text-gray-700">Customer</label>
    <select id="customer_id" name="customer_id" class="w-full px-3 py-2 border rounded">
      <% for _, customer in ipairs(customers) do %>
        <option value="<%= customer.id %>"><%= customer.first_name %> <%= customer.last_name %></option>
      <% end %>
    </select>
  </div>

  <div class="mb-4">
    <label for="make" class="block text-gray-700">Make</label>
    <input
      type="text"
      id="make"
      name="make"
      class="w-full px-3 py-2 border rounded"
      required
    />
  </div>

  <div class="mb-4">
    <label for="model" class="block text-gray-700">Model</label>
    <input
      type="text"
      id="model"
      name="model"
      class="w-full px-3 py-2 border rounded"
      required
    />
  </div>

  <div class="mb-4">
    <label for="year" class="block text-gray-700">Year</label>
    <input
      type="number"
      id="year"
      name="year"
      class="w-full px-3 py-2 border rounded"
      required
    />
  </div>

  <div class="mb-4">
    <label for="vin" class="block text-gray-700">VIN</label>
    <input
      type="text"
      id="vin"
      name="vin"
      class="w-full px-3 py-2 border rounded"
    />
  </div>

  <div class="mb-4">
    <label for="license_plate" class="block text-gray-700">License Plate</label>
    <input
      type="text"
      id="license_plate"
      name="license_plate"
      class="w-full px-3 py-2 border rounded"
    />
  </div>

  <div class="mb-4">
    <label for="color" class="block text-gray-700">Color</label>
    <input
      type="text"
      id="color"
      name="color"
      class="w-full px-3 py-2 border rounded"
    />
  </div>

  <button type="submit" class="btn btn-primary">Add Vehicle</button>